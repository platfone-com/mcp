# Platfone API key (required for stdio transport, optional for HTTP if passing x-api-key header)
PLATFONE_API_KEY=your_api_key_here

# Base URL (defaults to production)
# PLATFONE_API_URL=https://temp-number-api.com/api/v1

# Use sandbox for testing (no real money required. Top-up with fake money.)
# PLATFONE_API_URL=https://temp-number-api.com/test/api/v1

# HTTP transport only: header with the real client IP set by a trusted proxy (e.g. Cloudflare)
# MCP_CLIENT_IP_HEADER=cf-connecting-ip

# HTTP transport only: expose Prometheus metrics on a separate internal port
# MCP_METRICS_PORT=9464

